output "agent_public_key" {
  description = "Public key of the Agent in PEM format: either `agent_public_key` if passed in, or the public key of the convenience key generated by the module. Register it with the Platform Orchestrator for the Agent."
  value       = local.agent_public_key
}
output "agent_private_key" {
  description = "Private key of the Agent in PEM format: either `agent_private_key` if passed in, or the private key of the convenience key generated by the module in PKCS#8 format."
  value       = local.agent_private_key
  sensitive   = true
}
output "resource_definition_id" {
  description = "ID of the Resource Definition created for Agent. Use it to attach matching criteria as required in your setup."
  value       = humanitec_resource_definition.agent.id
}
